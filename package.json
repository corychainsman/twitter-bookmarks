{
  "name": "elsewhere-media-discovery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:cf": "vite build && wrangler deploy",
    "deploy:cf:staging": "vite build && wrangler deploy",
    "deploy:cf:production": "vite build && wrangler deploy --config wrangler.production.jsonc",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript contracts/openapi.yaml -o src/greenfield/generated/api.ts",
    "sync:ft": "FT_DATA_DIR=\"$PWD/.data/fieldtheory\" bun run scripts/sync-fieldtheory.ts",
    "sync:ft:resume": "FT_DATA_DIR=\"$PWD/.data/fieldtheory\" bun run scripts/sync-fieldtheory.ts",
    "sync:ft:full": "FT_DATA_DIR=\"$PWD/.data/fieldtheory\" bun run scripts/sync-fieldtheory.ts --rebuild",
    "auth:x:cookies": "bun run scripts/capture-x-cookies.ts",
    "auth:x:check": "bun run scripts/check-x-cookies.ts",
    "auth:x:ensure": "bun run scripts/ensure-x-cookies.ts",
    "auth:x:sync-browser-cookies": "bun run scripts/store-x-cookies-from-cdp.ts",
    "data:mirror": "bun run scripts/mirror-media.ts",
    "data:backfill-image-variants": "bun run scripts/backfill-image-variants.ts",
    "data:video-previews": "bun run scripts/generate-video-previews.ts",
    "mirror:sync": "bash scripts/sync-mirror.sh",
    "data:export": "bun run scripts/export-fieldtheory.ts",
    "data:embeddings": "bun run scripts/export-embeddings.ts",
    "data:validate": "bun run scripts/validate-export.ts",
    "refresh": "bun run scripts/refresh.ts",
    "refresh:resume": "bun run scripts/refresh.ts --resume",
    "refresh:full": "bun run scripts/refresh.ts --full",
    "refresh:embeddings": "bun run scripts/refresh.ts --embeddings",
    "refresh:production": "bun run scripts/refresh-production.ts",
    "refresh:production:full": "bun run scripts/refresh-production.ts --full"
  },
  "dependencies": {
    "@egjs/react-infinitegrid": "^4.13.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@huggingface/transformers": "^4.2.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.42.2",
    "minisearch": "^7.2.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "thumbhash": "^0.1.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.45.0",
    "@cloudflare/workers-types": "^5.20260716.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "fieldtheory": "1.3.9",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.4",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.107.0"
  }
}
