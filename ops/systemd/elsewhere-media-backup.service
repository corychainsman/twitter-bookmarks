[Unit]
Description=Back up Elsewhere media archive to Google Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/cory/twitter-bookmarks
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 0 %t/elsewhere-media-backup.lock /home/linuxbrew/.linuxbrew/bin/bun run backup:gdrive
TimeoutStartSec=24h
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
