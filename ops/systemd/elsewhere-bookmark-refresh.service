[Unit]
Description=Refresh and deploy X Inspo bookmarks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/cory/twitter-bookmarks
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
Environment=SKIP_GDRIVE_BACKUP=1
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 0 %t/elsewhere-bookmark-refresh.lock /home/linuxbrew/.linuxbrew/bin/bun run refresh:production
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
