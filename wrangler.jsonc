{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twitter-bookmarks",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    // index.html and 404.html share the client-side two-path route switch.
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "bookmarks.corychainsman.com", "custom_domain": true }
  ]
}
